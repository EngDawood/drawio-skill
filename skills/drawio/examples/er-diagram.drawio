<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Users Entity -->
    <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;hr&gt;PK: user_id&lt;br&gt;email&lt;br&gt;name&lt;br&gt;created_at" 
            style="whiteSpace=wrap;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="160" height="120" as="geometry"/>
    </mxCell>
    
    <!-- Posts Entity -->
    <mxCell id="posts" value="&lt;b&gt;Posts&lt;/b&gt;&lt;hr&gt;PK: post_id&lt;br&gt;FK: user_id&lt;br&gt;title&lt;br&gt;content&lt;br&gt;published_at" 
            style="whiteSpace=wrap;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="320" y="80" width="160" height="140" as="geometry"/>
    </mxCell>
    
    <!-- Comments Entity -->
    <mxCell id="comments" value="&lt;b&gt;Comments&lt;/b&gt;&lt;hr&gt;PK: comment_id&lt;br&gt;FK: post_id&lt;br&gt;FK: user_id&lt;br&gt;content&lt;br&gt;created_at" 
            style="whiteSpace=wrap;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="320" y="280" width="160" height="140" as="geometry"/>
    </mxCell>
    
    <!-- Tags Entity -->
    <mxCell id="tags" value="&lt;b&gt;Tags&lt;/b&gt;&lt;hr&gt;PK: tag_id&lt;br&gt;name&lt;br&gt;description" 
            style="whiteSpace=wrap;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="600" y="80" width="160" height="100" as="geometry"/>
    </mxCell>
    
    <!-- Post_Tags Junction Table -->
    <mxCell id="post_tags" value="&lt;b&gt;Post_Tags&lt;/b&gt;&lt;hr&gt;PK: post_id, tag_id&lt;br&gt;FK: post_id&lt;br&gt;FK: tag_id" 
            style="whiteSpace=wrap;align=left;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="600" y="260" width="160" height="100" as="geometry"/>
    </mxCell>
    
    <!-- Relationships -->
    
    <!-- User to Posts (1:N) -->
    <mxCell id="r1" value="writes" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=none;endArrow=classic;" 
            edge="1" parent="1" source="users" target="posts">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Posts to Comments (1:N) -->
    <mxCell id="r2" value="has" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=none;endArrow=classic;" 
            edge="1" parent="1" source="posts" target="comments">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- User to Comments (1:N) -->
    <mxCell id="r3" value="writes" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0;entryY=0.5;startArrow=none;endArrow=classic;" 
            edge="1" parent="1" source="comments" target="users">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="20" y="350"/>
          <mxPoint x="20" y="140"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Posts to Post_Tags (1:N) -->
    <mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.75;entryX=0;entryY=0.5;startArrow=none;endArrow=classic;" 
            edge="1" parent="1" source="posts" target="post_tags">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Tags to Post_Tags (1:N) -->
    <mxCell id="r5" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;startArrow=none;endArrow=classic;" 
            edge="1" parent="1" source="tags" target="post_tags">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Cardinality Labels -->
    <mxCell id="card1" value="1" style="text;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="205" y="120" width="20" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="card2" value="N" style="text;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="295" y="120" width="20" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="card3" value="1" style="text;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="390" y="225" width="20" height="20" as="geometry"/>
    </mxCell>
    
    <mxCell id="card4" value="N" style="text;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="390" y="255" width="20" height="20" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
