<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- API Gateway -->
    <mxCell id="gateway" value="API Gateway" style="rounded=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="240" y="40" width="160" height="60" as="geometry"/>
    </mxCell>
    
    <!-- User Service Container -->
    <mxCell id="user_svc" value="User Service" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="40" y="160" width="200" height="240" as="geometry"/>
    </mxCell>
    
    <mxCell id="user_api" value="REST API" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="user_svc">
      <mxGeometry x="20" y="50" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="user_logic" value="Business Logic" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="user_svc">
      <mxGeometry x="20" y="120" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="user_db" value="User DB" style="shape=cylinder3;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="user_svc">
      <mxGeometry x="60" y="185" width="80" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Product Service Container -->
    <mxCell id="prod_svc" value="Product Service" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="280" y="160" width="200" height="240" as="geometry"/>
    </mxCell>
    
    <mxCell id="prod_api" value="REST API" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="prod_svc">
      <mxGeometry x="20" y="50" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="prod_logic" value="Business Logic" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="prod_svc">
      <mxGeometry x="20" y="120" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="prod_db" value="Product DB" style="shape=cylinder3;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="prod_svc">
      <mxGeometry x="60" y="185" width="80" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Order Service Container -->
    <mxCell id="order_svc" value="Order Service" style="swimlane;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="520" y="160" width="200" height="240" as="geometry"/>
    </mxCell>
    
    <mxCell id="order_api" value="REST API" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="order_svc">
      <mxGeometry x="20" y="50" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="order_logic" value="Business Logic" style="rounded=1;whiteSpace=wrap;" vertex="1" parent="order_svc">
      <mxGeometry x="20" y="120" width="160" height="50" as="geometry"/>
    </mxCell>
    
    <mxCell id="order_db" value="Order DB" style="shape=cylinder3;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="order_svc">
      <mxGeometry x="60" y="185" width="80" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Message Queue -->
    <mxCell id="queue" value="Message Queue" style="shape=parallelogram;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="260" y="460" width="200" height="60" as="geometry"/>
    </mxCell>
    
    <!-- Edges from Gateway -->
    <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="user_api">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="prod_api">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="order_api">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Internal service connections -->
    <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="user_svc" source="user_api" target="user_logic">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="user_svc" source="user_logic" target="user_db">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="prod_svc" source="prod_api" target="prod_logic">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="prod_svc" source="prod_logic" target="prod_db">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="order_svc" source="order_api" target="order_logic">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="order_svc" source="order_logic" target="order_db">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Connections to Message Queue -->
    <mxCell id="e10" value="Events" style="edgeStyle=orthogonalEdgeStyle;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="user_logic" target="queue">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="120" y="440"/>
          <mxPoint x="220" y="440"/>
          <mxPoint x="220" y="490"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="e11" value="Events" style="edgeStyle=orthogonalEdgeStyle;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="prod_logic" target="queue">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <mxCell id="e12" value="Events" style="edgeStyle=orthogonalEdgeStyle;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="order_logic" target="queue">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="640" y="440"/>
          <mxPoint x="540" y="440"/>
          <mxPoint x="540" y="490"/>
        </Array>
      </mxGeometry>
    </mxCell>
  </root>
</mxGraphModel>
